---
/**
 * Page de départ d'un nouveau site. Elle n'affiche que ce que le brief
 * permet de publier ; la composition réelle se construit dans site/src/
 * après le choix de direction (porte G2).
 */
import config from 'virtual:factory/config';
---

<!doctype html>
<html lang={config.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={config.indexable ? 'index, follow' : 'noindex, nofollow'} />
    <title>{config.brand}</title>
  </head>
  <body>
    <main>
      <h1>{config.brand}</h1>
      <p>Site en préparation.</p>
    </main>
  </body>
</html>
