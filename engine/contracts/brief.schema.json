{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "draft",
        "preview",
        "release"
      ]
    },
    "site": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fictional": {
          "type": "boolean"
        },
        "establishmentCountry": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "brand",
        "fictional",
        "establishmentCountry"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "targetCountries": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "objectives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "differentiationFacts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primaryCta": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "contact-form",
                "email",
                "phone",
                "url"
              ]
            },
            "label": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "target": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "kind",
            "label"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "audience",
        "targetCountries",
        "primaryCta"
      ],
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "services",
            "catalog"
          ]
        },
        "categories": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "exclusions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "pricingFact": {
          "type": "string"
        },
        "availabilityFact": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "canonicalOrigin": {
          "type": "string",
          "maxLength": 300
        },
        "redirectDomains": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253
          }
        },
        "previewOrigin": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "canonicalOrigin"
      ],
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "publicContactFact": {
          "type": "string"
        },
        "recipient": {
          "type": "string",
          "maxLength": 254
        },
        "from": {
          "type": "string",
          "maxLength": 254
        },
        "sendingDomain": {
          "type": "string",
          "maxLength": 253
        },
        "replyTo": {
          "default": "submitter",
          "type": "string",
          "const": "submitter"
        },
        "transport": {
          "default": "none",
          "type": "string",
          "enum": [
            "smtp",
            "capture",
            "none"
          ]
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "security": {
              "type": "string",
              "enum": [
                "starttls",
                "tls"
              ]
            },
            "username": {
              "type": "string",
              "pattern": "^env:[A-Z][A-Z0-9_]{1,63}$"
            },
            "password": {
              "type": "string",
              "pattern": "^env:[A-Z][A-Z0-9_]{1,63}$"
            }
          },
          "required": [
            "host",
            "port",
            "security",
            "username",
            "password"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "properties": {
        "defaultLocale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "locales": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        },
        "missingTranslation": {
          "default": "omit",
          "type": "string",
          "const": "omit"
        }
      },
      "required": [
        "defaultLocale",
        "locales"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "references": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "url",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "antiReferences": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "brandConstraints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "availableResources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "allowGeneratedIllustrations": {
          "default": false,
          "type": "boolean"
        },
        "selectedDirection": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "decidedBy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "decidedOn": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              },
              "required": [
                "id",
                "decidedBy",
                "decidedOn"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "renderApproval": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "approvedBy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "approvedOn": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              },
              "required": [
                "approvedBy",
                "approvedOn",
                "scope"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "hosting": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "vps-nginx",
            "apache-shared",
            "vps-proxy"
          ]
        },
        "phpVersion": {
          "type": "string",
          "pattern": "^8\\.\\d+$"
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "processing": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "recipients": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "retentionFact": {
                "type": "string"
              }
            },
            "required": [
              "purpose",
              "recipients",
              "retentionFact"
            ],
            "additionalProperties": false
          }
        },
        "thirdPartyTools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "analytics": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "self-hosted-cookieless"
          ]
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "scope": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "reviewer": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "publicationAuthorization": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "grantedBy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "grantedOn": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "scopeDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "grantedBy",
                "grantedOn",
                "scopeDigest"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9.]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "proposed",
              "confirmed",
              "not_applicable"
            ]
          },
          "sourceRefs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "publication": {
            "default": "internal",
            "type": "string",
            "enum": [
              "public",
              "internal",
              "withheld"
            ]
          },
          "surfaces": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "html",
                "jsonld",
                "meta",
                "sitemap",
                "scripts",
                "documents"
              ]
            }
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "value",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "site",
    "identity",
    "market",
    "offer",
    "network",
    "email",
    "form",
    "i18n",
    "design",
    "hosting",
    "privacy",
    "delivery"
  ],
  "additionalProperties": false,
  "title": "Premium Website Factory — brief",
  "$id": "https://example.com/premium-website-factory/brief.schema.json"
}
