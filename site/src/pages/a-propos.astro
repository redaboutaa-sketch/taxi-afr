---
import Site from '../layouts/Site.astro';
import Fact from '../components/Fact.astro';
import { routes } from '../content/site.ts';
---
<Site title="Le chauffeur et le véhicule — AFR TAXI" description="AFR TAXI, taxi indépendant : qui conduit, avec quel véhicule, et comment le joindre." path="/a-propos/">
  <div class="wrap page-head stack">
    <h1>Le chauffeur et le véhicule</h1>
    <p class="lead">AFR TAXI est une activité de taxi indépendante : la personne qui répond au téléphone est celle qui conduit.</p>
  </div>
  <div class="wrap two-col">
    <div class="prose">
      <h2>Expérience</h2>
      <p><Fact k="driver.experience" /></p>
      <h2>Langues parlées</h2>
      <p class="cap"><Fact k="driver.languages" />.</p>
      <h2>Le véhicule</h2>
      <p>Une berline grise, équipée taxi : c’est celle que vous voyez sur la photo de la page d’accueil.</p>
      <h2>Secteur</h2>
      <p>Activité basée à <Fact k="business.locality" />. <Fact k="business.serviceArea" /></p>
    </div>
    <aside class="callout stack">
      <h2>Le taxi en photo</h2>
      <p>La photo en haut de la page d’accueil montre le véhicule d’AFR TAXI devant la gare de Saint-Rambert-d’Albon.</p>
      <p><a class="solo" href={routes.contact}>Contacter AFR TAXI</a></p>
    </aside>
  </div>
</Site>
