---
/**
 * Gabarit AFR TAXI — direction B « Bandeau » (choisie le 2026-11-24). Lit uniquement la configuration résolue (faits projetés).
 * Navigation MPA, aucun script global : l'appel et la navigation fonctionnent
 * sans JavaScript et sans traceur.
 */
import { Font } from 'astro:assets';
import config from 'virtual:factory/config';
import { factFor } from '@engine/astro';
import '../styles/base.css';
import '../../design/directions/bandeau.css';
import '../styles/motion.css';
import Icon from '../components/Icon.astro';
import { nav, routes, phone, telHref, email, services, whatsappDigits, fact, PROVISIONAL } from '../content/site.ts';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique de la page (avec barre finale). */
  path: string;
  noindex?: boolean;
  /** Masque la barre d'action mobile (pages où elle ferait doublon). */
  bar?: boolean;
}
const { title, description, path, noindex = false, bar = true } = Astro.props;
const abs = (p: string) => new URL(p, config.origin).href;
const current = (href: string) => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);

// Données structurées : uniquement des faits CONFIRMÉS autorisés sur la surface JSON-LD.
const confirmed = (k: string) => (config.facts[k] && !config.facts[k].provisional ? factFor(config, k, 'jsonld') : undefined);
const ldPhone = confirmed('contact.phoneE164');
const ldName = confirmed('legal.name');
const facebook = fact('social.facebook');
const ldFacebook = confirmed('social.facebook');
const ld = ldName && ldPhone
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: ldName,
      url: config.canonicalOrigin + '/',
      telephone: ldPhone,
      ...(confirmed('contact.email') ? { email: confirmed('contact.email') } : {}),
      ...(confirmed('business.serviceArea') ? { areaServed: confirmed('business.serviceArea') } : {}),
      ...(ldFacebook ? { sameAs: [ldFacebook] } : {}),
    }
  : null;
---

<!doctype html>
<html lang="fr" class="dir-bandeau">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={config.indexable && !noindex ? 'index, follow' : 'noindex, nofollow'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={abs(path)} />
    <link rel="canonical" href={abs(path)} />
    <meta name="theme-color" content="#15191f" />
    <Font cssVariable="--font-public-sans" preload={[{ weight: '100 900', style: 'normal' }]} />
    <Font cssVariable="--font-plex-condensed" preload />
    {ld && <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#contenu">Aller au contenu</a>
    {config.target === 'preview' && (
      <p class="preview-banner">Préversion non publiée, réservée à AFR TAXI.</p>
    )}
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href={routes.home} aria-label="AFR TAXI, accueil">
          <span class="brand-mark">AFR</span><span class="brand-word">TAXI</span>
        </a>
        <details class="menu">
          <summary><span class="menu-label">Menu</span></summary>
          <nav aria-label="Navigation principale">
            <ul>
              {nav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
            </ul>
          </nav>
        </details>
        <nav class="nav-wide" aria-label="Navigation principale">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
        {telHref && phone && (
          <a class="btn btn-call masthead-call" href={telHref}><Icon name="phone" /><span>{phone.text}</span></a>
        )}
        {whatsappDigits && (
          <a class="btn btn-whatsapp masthead-call" href={`https://wa.me/${whatsappDigits}`} rel="noopener noreferrer"><Icon name="chat" /><span>WhatsApp</span></a>
        )}
      </div>
    </header>

    <main id="contenu"><slot /></main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">AFR TAXI</p>
          {telHref && phone && <p><a href={telHref}>{phone.text}</a>{phone.provisional && <span class="provisional">{PROVISIONAL}</span>}</p>}
          {email && <p><a href={`mailto:${email.text}`}>{email.text}</a>{email.provisional && <span class="provisional">{PROVISIONAL}</span>}</p>}
          {facebook && <p><a href={facebook.text} rel="noopener noreferrer">AFR TAXI sur Facebook</a></p>}
        </div>
        <nav aria-label="Services">
          <p class="footer-title">Services</p>
          <ul>{services.map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul>
        </nav>
        <nav aria-label="Informations">
          <p class="footer-title">Informations</p>
          <ul>
            <li><a href={routes.apropos}>Le chauffeur</a></li>
            <li><a href="/#avis">Avis clients</a></li>
            <li><a href={routes.contact}>Contact et demande de trajet</a></li>
            <li><a href={routes.mentions}>Mentions légales</a></li>
            <li><a href={routes.vie}>Vie privée</a></li>
          </ul>
        </nav>
      </div>
      
    </footer>

    {bar && (
      <nav class="action-bar" aria-label="Actions rapides">
        {telHref && <a class="btn btn-call" href={telHref}><Icon name="phone" /><span>Appeler</span></a>}
        <a class="btn btn-primary" href={routes.demande}><Icon name="route" /><span>Demander un trajet</span></a>
      </nav>
    )}
  </body>
</html>
