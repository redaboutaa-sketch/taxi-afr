---
/**
 * Accueil : hero → besoins/services → organisation en trois étapes →
 * chauffeur et véhicule → secteur → réponses utiles → contact.
 */
import Site from '../layouts/Site.astro';
import Icon from './Icon.astro';
import RouteArt from './RouteArt.astro';
import RequestForm from './RequestForm.astro';
import { Picture } from 'astro:assets';
import assets from 'virtual:factory/assets';
import { routes, services, phone, telHref, locality, hours, fact, whatsappDigits, PROVISIONAL } from '../content/site.ts';

interface Props { path?: string; }
const { path = '/' } = Astro.props;
const town = locality?.text.split(' (')[0] ?? null;
const visible = services.filter((s) => fact(s.key));
const experience = fact('driver.experience');
const languages = fact('driver.languages');
// Photo du véhicule réel : seulement si l'actif est publiable (registre).
const photo = assets['taxi-gare'];
---

<Site
  title={town ? `AFR TAXI — Votre taxi à ${town}` : 'AFR TAXI — Taxi local'}
  description="Taxi privé, transferts vers les gares et aéroports, transport de patients conventionné et déplacement après un incident. Appel direct ou demande de trajet en ligne."
  path={path}
  noindex={path !== '/'}
>
  <section class="hero" aria-labelledby="hero-title">
    {photo && (
      <div class="hero-media">
        <Picture src={photo.src} alt={photo.alt.fr ?? ''} widths={[480, 768, 1100, 1500]} sizes="(min-width: 62rem) 100vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" class="hero-photo" />
      </div>
    )}
    <div class="wrap hero-grid">
      <div class="hero-text stack">
        {locality && (
          <p class="badge-place"><Icon name="pin" /> Taxi à {locality.text}{locality.provisional && <span class="provisional">{PROVISIONAL}</span>}</p>
        )}
        <h1 id="hero-title">{town ? <>Votre taxi à <em>{town}</em></> : 'Votre taxi local'}</h1>
        <p class="lead">Déplacements privés et professionnels, transferts gares et aéroports, transport de patients sur prescription et longue distance.</p>
        <ul class="checklist" role="list">
          {experience && <li><Icon name="check" /><span>{experience.text}{experience.provisional && <span class="provisional">{PROVISIONAL}</span>}</span></li>}
          {hours && <li><Icon name="check" /><span>{hours.text}{hours.provisional && <span class="provisional">{PROVISIONAL}</span>}</span></li>}
          <li><Icon name="check" /><span>Demande simple : en ligne, par WhatsApp ou par téléphone</span></li>
          <li><Icon name="check" /><span>Le chauffeur confirme chaque trajet</span></li>
        </ul>
        <div class="hero-ctas">
          <a class="btn btn-call" href="#demande"><Icon name="route" /><span>Demander un trajet</span></a>
          {telHref && phone && <a class="btn btn-outline" href={telHref}><Icon name="phone" /><span>{phone.text}</span></a>}
          {whatsappDigits && <a class="btn btn-whatsapp" href={`https://wa.me/${whatsappDigits}`} rel="noopener noreferrer"><Icon name="chat" /><span>Écrire sur WhatsApp</span></a>}
        </div>
      </div>
      <div class="hero-form">
        <RequestForm />
      </div>
    </div>
  </section>

  <section class="facts-strip" aria-label="Repères">
    <ul class="wrap" role="list">
      {hours && <li><Icon name="clock" /><span><strong>Disponibilité annoncée</strong><br />{hours.text}{hours.provisional && <span class="provisional">{PROVISIONAL}</span>}</span></li>}
      <li><Icon name="phone" /><span><strong>Appel direct</strong><br />pour un départ imminent</span></li>
      <li><Icon name="route" /><span><strong>Demande en ligne</strong><br />pour un trajet planifié</span></li>
      {languages && <li><Icon name="chat" /><span><strong>Langues parlées</strong><br />{languages.text}{languages.provisional && <span class="provisional">{PROVISIONAL}</span>}</span></li>}
    </ul>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap stack-lg">
      <div class="stack">
        <h2 id="services-title">Quel est votre besoin ?</h2>
        <p class="lead">Chaque service a sa page : ce qui est proposé, comment l’organiser, ce qui n’est pas promis.</p>
      </div>
      <ul class="services-cards" role="list">
        {visible.map((s) => (
          <li>
            <a href={s.href} class:list={{ 'has-media': Boolean(assets[s.image]) }}>
              {assets[s.image] && (
                <span class="card-media">
                  <Picture src={assets[s.image]!.src} alt={assets[s.image]!.decorative ? '' : (assets[s.image]!.alt.fr ?? '')} widths={[320, 480, 640, 900]} sizes="(min-width: 62rem) 25vw, (min-width: 40rem) 50vw, 100vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
                  {assets[s.image]!.kind === 'illustration' && <span class="media-label" aria-hidden="true">Illustration</span>}
                </span>
              )}
              <span class="card-body">
                <span class="badge"><Icon name={s.icon} /></span>
                <h3>{s.title}{fact(s.key)?.provisional && <span class="provisional">{PROVISIONAL}</span>}</h3>
                <p>{s.text}</p>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-tight steps-section" aria-labelledby="steps-title">
    <div class="wrap two-col">
      <div class="stack">
        <h2 id="steps-title">Comment ça se passe</h2>
        <RouteArt />
      </div>
      <ol class="steps" role="list">
        <li><h3>Décrivez le trajet</h3><p>Départ, destination, date et heure : rien d’autre n’est obligatoire.</p></li>
        <li><h3>Envoyez par WhatsApp ou par e-mail</h3><p>Ou appelez pour un départ dans moins d’une heure.</p></li>
        <li><h3>Le chauffeur vous recontacte</h3><p>Il confirme, ou non, la possibilité du trajet et vous indique le tarif.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="chauffeur-title">
    <div class="wrap two-col">
      <div class="stack">
        <h2 id="chauffeur-title">Un chauffeur indépendant, joignable directement</h2>
        {experience && <p>{experience.text}{experience.provisional && <span class="provisional">{PROVISIONAL}</span>}.</p>}
        <p>Vous parlez à la personne qui conduit : elle vous indique si le trajet est possible, à quelle heure partir et ce qu’il faut prévoir.</p>
        <p><a class="solo" href={routes.apropos}>En savoir plus sur le chauffeur et le véhicule</a></p>
      </div>
      <div class="callout">
        <p><strong>Véhicule</strong></p>
        <p>La photo de l’accueil montre le véhicule réel, devant la gare de Saint-Rambert-d’Albon.</p>
      </div>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="faq-title">
    <div class="wrap faq stack">
      <h2 id="faq-title">Réponses utiles</h2>
      <details>
        <summary>Ma demande en ligne vaut-elle réservation ?</summary>
        <p>Non. Elle transmet votre trajet au chauffeur, qui vous rappelle pour confirmer ou non sa possibilité. Pour un départ imminent, appelez directement.</p>
      </details>
      <details>
        <summary>Quel est le prix d’un trajet ?</summary>
        <p>Le tarif dépend du trajet et de l’horaire. Demandez-le au chauffeur lors de l’appel ou de sa réponse ; aucun tarif n’est affiché tant qu’il n’a pas été validé.</p>
      </details>
      <details>
        <summary>Le transport de patients est-il pris en charge ?</summary>
        <p>Cela dépend de votre prescription et de votre situation auprès de l’Assurance Maladie. <a href={routes.medical}>Voir les conditions et ce qu’il faut prévoir</a>.</p>
      </details>
      <details>
        <summary>Et si je n’utilise pas WhatsApp ?</summary>
        <p>Envoyez la demande par e-mail depuis le formulaire, ou appelez : les deux restent disponibles.</p>
      </details>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="contact-title">
    <div class="wrap callout stack">
      <h2 id="contact-title">Besoin d’un taxi ?</h2>
      <div class="cta-row">
        {telHref && phone && <a class="btn btn-call" href={telHref}><Icon name="phone" /><span>Appeler le {phone.text}</span></a>}
        <a class="btn btn-primary" href="#demande"><Icon name="route" /><span>Demander un trajet</span></a>
      </div>
    </div>
  </section>
</Site>
