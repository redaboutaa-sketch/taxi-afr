---
/**
 * Demande de trajet (carte compacte). Une seule saisie, deux envois au choix :
 *  - WhatsApp (principal) : le script valide AVEC LES RÈGLES DU SERVEUR,
 *    affiche un récapitulatif, puis un lien de conversation construit au clic.
 *    Aucune requête vers notre serveur ; rien n'est envoyé tant que le
 *    visiteur n'appuie pas sur Envoyer dans WhatsApp.
 *  - e-mail : POST vers l'endpoint du moteur (fonctionne SANS JavaScript :
 *    page de résultat) ; le script ajoute l'envoi sans rechargement.
 */
import form from 'virtual:factory/form';
import Icon from './Icon.astro';
import { request as t } from '../content/request.ts';
import { whatsappDigits, telHref, phone } from '../content/site.ts';

interface Props { headingLevel?: 1 | 2; }
const { headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
if (!form) throw new Error('contrat de formulaire requis (site/content/form.yaml)');
const fields = form.contract.fields;
const wide = new Set(['pickup', 'dropoff']);
const clientData = JSON.stringify({
  contract: form.server,
  endpoint: form.endpoint,
  whatsapp: whatsappDigits,
  messages: {
    errors: t.errors, accepted: t.accepted, unavailable: t.unavailable, network: t.network, summary: t.summary,
    sending: t.sending, submit: t.submitEmail, copied: t.recapCopied, copyFailed: t.recapCopyFailed,
  },
});
const types = { tel: 'tel', email: 'email', date: 'date', time: 'time', integer: 'number' } as const;
const inputType = (kind: string): 'tel' | 'email' | 'date' | 'time' | 'number' | 'text' => types[kind as keyof typeof types] ?? 'text';
---

<div class="request" id="demande">
  <div class="request-head">
    <span class="request-icon"><Icon name="route" /></span>
    <div>
      <Heading class="request-title">{t.formTitle}</Heading>
      <p class="request-intro">{t.formIntro}</p>
    </div>
  </div>
  <div class="status" data-form-status role="status" aria-live="polite" tabindex="-1" hidden></div>
  <form method="post" action={form.endpoint} novalidate data-request-form data-client={clientData} aria-describedby="request-notice">
    <div class="summary-box" data-form-summary tabindex="-1" hidden>
      <h3>{t.summary}</h3>
      <ul data-form-summary-list></ul>
    </div>
    <input type="hidden" name="locale" value="fr" />
    <div class="fields">
      {fields.map((f) => {
        const errId = `${f.name}-error`;
        return (
          <div class:list={['field', { 'field-wide': wide.has(f.name) }]}>
            <label for={f.name}>{f.label.fr}{f.required ? <span class="req" aria-hidden="true"> *</span> : <span class="optional"> {t.optional}</span>}</label>
            <input
              id={f.name}
              name={f.name}
              type={inputType(f.kind)}
              required={f.required}
              maxlength={f.kind === 'integer' || f.kind === 'date' || f.kind === 'time' ? undefined : f.maxLength}
              min={f.kind === 'integer' ? f.min : undefined}
              max={f.kind === 'integer' ? f.max : undefined}
              step={f.kind === 'integer' ? 1 : undefined}
              inputmode={f.kind === 'integer' ? 'numeric' : undefined}
              autocomplete={f.autocomplete}
              aria-describedby={errId}
              spellcheck={f.kind === 'tel' ? 'false' : undefined}
            />
            <p class="error" id={errId} data-error-for={f.name}></p>
          </div>
        );
      })}
    </div>
    <div class="trap" aria-hidden="true">
      <label for={form.contract.honeypot}>Ne pas remplir</label>
      <input id={form.contract.honeypot} name={form.contract.honeypot} type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="notice" id="request-notice"><strong>{t.notice}</strong> <span class="notice-detail">{t.noticeDetail}</span></p>

    <div class="actions">
      {whatsappDigits && (
        <div>
          <button class="btn btn-whatsapp" type="button" data-whatsapp hidden><Icon name="chat" /><span>{t.whatsapp}</span></button>
          <noscript>
            <a class="btn btn-whatsapp" href={`https://wa.me/${whatsappDigits}`} rel="noopener noreferrer"><Icon name="chat" /><span>{t.whatsappNoJs}</span></a>
          </noscript>
          <p class="action-help">{t.whatsappHelp}</p>
        </div>
      )}
      <div>
        <button class:list={['btn', whatsappDigits ? 'btn-secondary' : 'btn-primary']} type="submit" data-submit><Icon name="mail" /><span data-submit-label>{t.submitEmail}</span></button>
        <p class="action-help action-help-email">{t.submitEmailHelp}</p>
      </div>
      {!whatsappDigits && <p class="action-help" data-whatsapp-unavailable>{t.whatsappUnavailable}</p>}
    </div>

    <section class="recap" data-recap tabindex="-1" aria-labelledby="recap-title" hidden>
      <h3 id="recap-title">{t.recapTitle}</h3>
      <p>{t.recapIntro}</p>
      <pre data-recap-text></pre>
      <div class="cta-row">
        <a class="btn btn-whatsapp" data-recap-open href="#demande" target="_blank" rel="noopener noreferrer"><Icon name="chat" /><span>{t.recapOpen}</span></a>
        <button class="btn btn-ghost" type="button" data-recap-copy>{t.recapCopy}</button>
      </div>
      <p data-recap-copy-status role="status" aria-live="polite"></p>
      <p>{t.recapAfter}</p>
      {telHref && phone && <p><a class="solo" href={telHref}>Appeler le {phone.text}</a></p>}
    </section>
  </form>
</div>

<script>
  import { initRequestForm } from '../scripts/request-form.ts';
  initRequestForm();
</script>
