---
/**
 * PROTOTYPE — Piste B « Plan d'atelier ». Non publiable : injecté uniquement
 * hors production. Même contenu que la piste A ; composition, densité,
 * typographie et traitement du CTA différents.
 */
import { Font } from 'astro:assets';
import config from 'virtual:factory/config';
import '../directions/atelier.css';
import { demoNotice, exclusions, hero, services, steps } from './_content.ts';

const spec = [
  ['Périmètre', 'Dépenses externes de l’entreprise'],
  ['Données', 'Export comptable, aucun outil à installer'],
  ['Livrable', 'Cartographie et plan d’action priorisé'],
  ['Durée', '15 jours ouvrés'],
] as const;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Prototype B — Plan d’atelier · {config.brand}</title>
    <Font cssVariable="--font-plex-condensed" preload={[{ weight: 600, style: 'normal' }]} />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body class="dir-atelier">
    <p class="demo">{demoNotice} <span>Prototype de direction B — contenu représentatif, non validé.</span></p>

    <div class="slate">
      <header class="bar">
        <a class="wordmark" href="#top" aria-label="Ostral Conseil — haut de page"><span class="mark" aria-hidden="true"></span>OSTRAL<span class="sub">conseil achats</span></a>
        <nav aria-label="Navigation principale">
          <ul>
            <li><a href="#offre">Offre</a></li>
            <li><a href="#methode">Méthode</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </header>

      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="hero-main">
          <p class="tag">{hero.kicker}</p>
          <h1 id="hero-title">{hero.title}</h1>
          <p class="lead">{hero.lead}</p>
          <p class="actions">
            <a class="button" href="#contact">{hero.cta}</a>
            <a class="ghost" href="#offre">{hero.secondary}</a>
          </p>
        </div>
        <aside class="sheet" aria-labelledby="sheet-title">
          <p class="sheet-ref" aria-hidden="true">FICHE 01 / DIAGNOSTIC</p>
          <h2 id="sheet-title">Ce que couvre un diagnostic</h2>
          <dl>
            {spec.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>
                  {v}
                  {k === 'Durée' && config.target === 'preview' && <span class="provisional">à confirmer</span>}
                </dd>
              </div>
            ))}
          </dl>
        </aside>
      </section>
    </div>

    <main>
      <section id="offre" class="band" aria-labelledby="offre-title">
        <header class="band-head">
          <p class="ref" aria-hidden="true">02</p>
          <h2 id="offre-title">Offre</h2>
          <p class="band-lead">Trois interventions, utilisables séparément. Le diagnostic précède généralement les deux autres.</p>
        </header>
        <ol class="modules">
          {services.map((s) => (
            <li id={s.id}>
              <p class="ref">{s.n}</p>
              <h3>{s.title}</h3>
              <p class="for">{s.for}</p>
              <dl>
                <div><dt>Livrable</dt><dd>{s.get}</dd></div>
                <div>
                  <dt>Durée</dt>
                  <dd>{s.duration}{s.provisional && config.target === 'preview' && <span class="provisional">à confirmer</span>}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ol>
      </section>

      <section id="methode" class="band" aria-labelledby="methode-title">
        <header class="band-head">
          <p class="ref" aria-hidden="true">03</p>
          <h2 id="methode-title">Méthode</h2>
        </header>
        <ol class="flow">
          {steps.map((s, i) => (
            <li>
              <span class="node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="band band-split" aria-labelledby="exclusions-title">
        <header class="band-head">
          <p class="ref" aria-hidden="true">04</p>
          <h2 id="exclusions-title">Hors périmètre</h2>
        </header>
        <ul class="out">{exclusions.map((e) => <li>{e}</li>)}</ul>
      </section>
    </main>

    <section id="contact" class="signal" aria-labelledby="contact-title">
      <h2 id="contact-title">Une situation d’achats à clarifier ?</h2>
      <p>Décrivez-la en quelques lignes. Nous vous dirons si nous pouvons aider.</p>
      <p class="actions"><a class="button-dark" href="#contact">{hero.cta}</a><a class="mail" href="mailto:contact@example.com">contact@example.com</a></p>
    </section>
    <footer class="foot"><p>Ostral Conseil — entreprise fictive de démonstration.</p></footer>
  </body>
</html>

<style>
  @layer reset, base, components;

  @layer reset {
    :global(*, *::before, *::after) { box-sizing: border-box; }
    :global(body, h1, h2, h3, p, ol, ul, dl, dd) { margin: 0; }
    :global(ol, ul) { padding: 0; list-style: none; }
  }

  @layer base {
    :global(body.dir-atelier) {
      background: var(--chalk); color: var(--ink);
      font-family: var(--font-text); font-size: var(--step-0); line-height: 1.5;
      -webkit-text-size-adjust: 100%;
    }
    a { color: inherit; }
    a:focus-visible { outline: 3px solid var(--focus-on-light); outline-offset: 3px; }
    .slate a:focus-visible, .signal a:focus-visible { outline-color: var(--focus); }
    .signal a:focus-visible { outline-color: var(--ink); }
    h1, h2, h3 { font-family: var(--font-display); font-weight: 600; text-wrap: balance; }
  }

  @layer components {
    .demo { background: var(--signal); color: var(--signal-ink); font-family: var(--font-data); font-size: var(--step--1); padding: 0.45rem clamp(1rem, 4vw, 3rem); }

    .slate {
      background-color: var(--slate); color: var(--text-on-slate);
      background-image:
        linear-gradient(var(--line-on-slate) 1px, transparent 1px),
        linear-gradient(90deg, var(--line-on-slate) 1px, transparent 1px);
      background-size: 100% 4rem, 4rem 100%;
      background-position: 0 -1px, -1px 0;
    }
    .bar, .hero, .band, .signal, .foot { max-width: var(--page); margin-inline: auto; padding-inline: clamp(1rem, 4vw, 3rem); }
    .bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--line-on-slate); }
    .wordmark { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; font-family: var(--font-display); font-weight: 600; letter-spacing: 0.18em; font-size: var(--step-1); }
    .mark { width: 0.9rem; height: 0.9rem; background: var(--signal); }
    .sub { font-family: var(--font-data); font-size: var(--step--1); letter-spacing: 0; color: var(--muted-on-slate); font-weight: 400; }
    nav ul { display: flex; gap: clamp(0.5rem, 2vw, 1.5rem); }
    nav a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 0.5rem; text-decoration: none; font-family: var(--font-data); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; }
    nav a:hover { color: var(--signal); }

    .hero { display: grid; gap: var(--space-l); padding-block: var(--space-l); }
    @media (min-width: 62rem) { .hero { grid-template-columns: 7fr 5fr; align-items: end; } }
    .tag { font-family: var(--font-data); font-size: var(--step--1); color: var(--signal); text-transform: uppercase; letter-spacing: 0.06em; }
    h1 { font-size: var(--step-3); line-height: 1.04; margin-top: var(--space-s); max-width: 18ch; color: var(--white); }
    .lead { margin-top: var(--space-m); max-width: 46ch; color: var(--text-on-slate); font-size: var(--step-1); line-height: 1.45; }
    .actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); align-items: center; }
    .button { display: inline-flex; align-items: center; min-height: 48px; padding: 0.7rem 1.25rem; background: var(--signal); color: var(--signal-ink); font-weight: 600; text-decoration: none; }
    .button:hover { background: var(--white); }
    .ghost { display: inline-flex; align-items: center; min-height: 48px; padding: 0.7rem 1.25rem; border: 1px solid var(--muted-on-slate); text-decoration: none; }
    .ghost:hover { border-color: var(--white); }

    .sheet { background: var(--slate-2); border: 1px solid var(--line-on-slate); padding: var(--space-m); }
    .sheet-ref, .ref { font-family: var(--font-data); font-size: var(--step--1); color: var(--muted-on-slate); }
    .sheet h2 { font-size: var(--step-1); color: var(--white); margin-top: 0.4rem; }
    .sheet dl { margin-top: var(--space-s); }
    .sheet dl > div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 0.75rem; padding-block: 0.6rem; border-top: 1px solid var(--line-on-slate); }
    .sheet dt { font-family: var(--font-data); font-size: var(--step--1); color: var(--muted-on-slate); text-transform: uppercase; }
    @media (max-width: 30rem) { .sheet dl > div { grid-template-columns: 1fr; gap: 0.15rem; } }
    .provisional { display: inline-block; margin-left: 0.5em; font-family: var(--font-data); font-size: var(--step--1); border: 1px dashed currentColor; padding: 0 0.35em; }

    .band { padding-block: var(--space-l); display: grid; gap: var(--space-m); border-bottom: 1px solid var(--line); }
    @media (min-width: 62rem) { .band { grid-template-columns: 3fr 9fr; } }
    .band .ref { color: var(--ink-muted); }
    .band-head h2 { font-size: var(--step-3); line-height: 1; text-transform: uppercase; letter-spacing: 0.02em; }
    .band-lead { margin-top: var(--space-s); color: var(--ink-muted); max-width: 32ch; }

    .modules { display: grid; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
    @media (min-width: 48rem) { .modules { grid-template-columns: repeat(3, 1fr); } }
    .modules > li { padding: var(--space-m); border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--white); display: flex; flex-direction: column; gap: 0.6rem; }
    .modules h3 { font-size: var(--step-1); line-height: 1.15; }
    .for { color: var(--ink-muted); }
    .modules dl { margin-top: auto; padding-top: var(--space-s); }
    .modules dl > div { border-top: 1px solid var(--line); padding-block: 0.5rem; }
    .modules dt { font-family: var(--font-data); font-size: var(--step--1); text-transform: uppercase; color: var(--ink-muted); }

    .flow { display: grid; gap: 0; position: relative; }
    @media (min-width: 48rem) { .flow { grid-template-columns: repeat(4, 1fr); } }
    .flow li { position: relative; padding: 0 var(--space-s) var(--space-m) 0; }
    .flow li::before { content: ''; position: absolute; left: 0; right: 0; top: 1.25rem; height: 2px; background: var(--ink); }
    .flow li:last-child::before { right: auto; width: 2.5rem; }
    @media (max-width: 47.99rem) {
      .flow li { padding: 0 0 var(--space-m) 3.5rem; }
      .flow li::before { left: 1.25rem; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
      .flow li:last-child::before { height: 2.5rem; bottom: auto; width: 2px; }
      .flow .node { position: absolute; left: 0; top: 0; }
    }
    .node { position: relative; z-index: 1; display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; background: var(--slate); color: var(--signal); font-family: var(--font-data); font-size: var(--step--1); }
    .flow h3 { font-size: var(--step-1); margin-top: var(--space-s); }
    .flow p { color: var(--ink-muted); max-width: 30ch; margin-top: 0.3rem; }

    .out li { padding-block: 0.6rem; border-bottom: 1px solid var(--line); display: flex; gap: 0.75rem; }
    .out li::before { content: '×'; font-family: var(--font-data); color: var(--ink-muted); }

    .signal { max-width: none; background: var(--signal); color: var(--signal-ink); padding-block: var(--space-l); }
    .signal > * { max-width: calc(var(--page) - 6rem); margin-inline: auto; }
    .signal h2 { font-size: var(--step-3); line-height: 1.04; text-transform: uppercase; }
    .signal p { margin-top: var(--space-s); font-size: var(--step-1); }
    .button-dark { display: inline-flex; align-items: center; min-height: 48px; padding: 0.7rem 1.25rem; background: var(--slate); color: var(--white); text-decoration: none; font-weight: 600; }
    .button-dark:hover { background: var(--slate-2); }
    .mail { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-data); }
    .foot { padding-block: var(--space-m); font-family: var(--font-data); font-size: var(--step--1); color: var(--ink-muted); }
  }
</style>
