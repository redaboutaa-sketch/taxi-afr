{
  "name": "premium-website-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Template de production de sites vitrines et B2B statiques, avec moteur actualisable et contrôles bloquants.",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24.22.3 <25 || >=26.13.1 <27"
  },
  "scripts": {
    "factory:init": "node engine/cli/main.ts init",
    "factory:doctor": "node engine/cli/main.ts doctor",
    "factory:validate": "node engine/cli/main.ts validate",
    "factory:schema": "node engine/cli/main.ts schema",
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "node engine/cli/main.ts schema --check && astro check && tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "build": "node engine/cli/main.ts validate --mode preview && astro build",
    "shots:prototype": "node tests/prototype/capture.ts",
    "release": "node engine/cli/main.ts release",
    "qa:release": "node engine/cli/main.ts qa-release",
    "qa:recipe": "node tests/recipe/nginx-php.ts",
    "qa:perf": "node tests/perf/lighthouse.ts",
    "factory:manifest": "node engine/cli/main.ts manifest",
    "factory:upgrade": "node engine/cli/main.ts upgrade",
    "factory:migrate": "node engine/cli/main.ts migrate",
    "qa:deploy": "node tests/recipe/deploy.ts",
    "factory:assets": "node engine/cli/main.ts assets",
    "release:verify": "node engine/cli/main.ts release-verify"
  },
  "dependencies": {
    "astro": "7.4.13",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
